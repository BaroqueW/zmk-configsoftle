#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#include "../zmk-nodefree-config/helper.h"
#include "../zmk-nodefree-config/international_chars/swedish.dtsi"

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define LOWER_WAIT 4

/ {
    behaviors {
        /*
         * Temporary sticky layer used to detect the second LOWER tap.
         *
         * It behaves like a normal sticky layer (&sl), but expires
         * after 300ms instead of the normal 1000ms.
         */
        lower_wait: lower_wait {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;

            bindings = <&mo>;

            release-after-ms = <300>;
            quick-release;
        };

        /*
         * LOWER thumb behavior:
         *
         * Hold -> momentary LOWER
         * Tap  -> activate LOWER_WAIT for 300ms
         *
         * On LOWER_WAIT, pressing this same physical key again
         * activates sticky ADJUST.
         */
        lower_key: lower_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "hold-preferred";
            tapping-term-ms = <200>;

            bindings = <&mo>, <&lower_wait>;
        };
    };

    /*
     * Holding LOWER + RAISE still activates ADJUST.
     */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |   `   |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   =   |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | ENTER |
            //               | CTRL | GUI  | ALT  | LOWER| SPACE  |  | RAISE | LEFT | UP    | DOWN  | RIGHT|

            bindings = <
&kp ESCAPE  &kp N1  &kp N2     &kp N3        &kp N4        &kp N5                             &kp N6          &kp N7        &kp N8          &kp N9           &kp N0    &kp BACKSPACE
&kp GRAVE   &kp Q   &kp W      &kp E         &kp R         &kp T      &kp Y                                   &kp U         &kp I           &kp O            &kp P     &kp EQUAL
&kp TAB     &kp A   &kp S      &kp D         &kp F         &kp G      &kp H                                   &kp J         &kp K           &kp L            &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X      &kp C         &kp V         &kp B      &kp C_MUTE  &kp C_PLAY  &kp N           &kp M         &kp COMMA       &kp DOT          &kp FSLH  &kp ENTER
                    &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &lower_key LOWER LOWER_WAIT  &kp SPACE   &mo RAISE   &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        lower_layer {
            display-name = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |  TAB  |  Å  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // | CAPS  |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |  _  |  _   |      |      |      |  |       |      |       |       |      |

            bindings = <
&trans     &kp F1          &kp F2          &kp F3          &kp F4    &kp F5                        &kp F6    &kp F7    &kp F8     &kp F9     &kp F10    &kp F11
&kp GRAVE  &kp N1          &kp N2          &kp N3          &kp N4    &kp N5     &kp N6                       &kp N7    &kp N8     &kp N9     &kp N0     &kp F12
&kp TAB    &sv_ao          &kp AT          &kp HASH        &kp DLLR  &kp PRCNT  &kp CARET                    &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR   &kp PIPE
&kp CAPS   &kp EQUAL       &kp MINUS       &kp PLUS        &kp LBRC  &kp RBRC   &trans     &trans  &kp LBKT  &kp RBKT  &kp SEMI   &kp COLON  &kp BSLH   &trans
                      &kp UNDERSCORE  &kp UNDERSCORE  &trans    &trans     &trans     &trans  &trans    &trans    &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |  DEL  |
            // |       | INS  | PSCR | MENU  |       |      |                | PGUP |      |   ^   |      |   0   |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |STUDIO|      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                       &trans  &trans    &trans    &trans     &trans   &kp DEL
&trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans          &kp PG_UP                  &trans    &kp UP    &trans     &kp N0   &trans
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK        &kp PG_DN                  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &studio_unlock  &trans     &trans  &trans  &trans    &trans    &trans     &trans   &trans
                          &trans        &trans        &trans        &trans          &trans     &trans  &trans  &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        adjust_layer {
            display-name = "adjust";

            // ----------------------------------------------------------------------------------------------------------------------------
            // Normal right-hand DEFAULT keys copied onto the LEFT side:
            //
            // |   6   |  7  |  8  |  9  |  0  | BKSPC |
            // |   Y   |  U  |  I  |  O  |  P  |   =   |
            // |   H   |  J  |  K  |  L  |  ;  |   '   |
            // |   N   |  M  |  ,  |  .  |  /  | ENTER |

            bindings = <
&kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp BACKSPACE                           &none  &none  &none  &none  &none  &none
&kp Y      &kp U   &kp I      &kp O    &kp P     &kp EQUAL      &none                          &none  &none  &none  &none  &none
&kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT        &none                          &none  &none  &none  &none  &none
&kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER      &none  &none  &none  &none  &none  &none  &none  &none
                    &trans    &trans    &trans     &trans         &trans  &none  &none  &none  &none  &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        /*
         * Internal state layer.
         *
         * All keys are transparent except the physical LOWER key.
         *
         * Therefore:
         *
         *   LOWER tap -> LOWER_WAIT
         *
         *   LOWER_WAIT + Q
         *       -> Q falls through to DEFAULT
         *       -> LOWER_WAIT disappears
         *
         *   LOWER_WAIT + LOWER
         *       -> &sl ADJUST
         *       -> LOWER_WAIT disappears
         *       -> ADJUST remains armed for next key
         */
        lower_wait_layer {
            display-name = "lower-wait";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &sl ADJUST  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };
    };
};
